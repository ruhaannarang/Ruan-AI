# Server Network Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Frontend Client Origin
CLIENT_URL=http://localhost:5173

# AI Runtime Endpoints (Decoupled Services)
# Default Local LLM (LM Studio)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gemma-4-e2b-it-qat

# Optional Online LLM Provider: NVIDIA NIM API
# When NVIDIA_NIM_API_KEY is provided, Ruan AI can optionally use NVIDIA NIM cloud models.
# Obtain a free API key from NVIDIA Build: https://build.nvidia.com/
# Leave empty to run 100% locally with LM Studio.
LLM_PROVIDER=local
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_NIM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_NIM_TIMEOUT_MS=90000

# Optional Online LLM Provider: NVIDIA NIM API
# When NVIDIA_NIM_API_KEY is provided, Ruan AI can optionally use NVIDIA NIM cloud models.
# Obtain a free API key from NVIDIA Build: https://build.nvidia.com/
# Leave empty to run 100% locally with LM Studio.
LLM_PROVIDER=local
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_NIM_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_NIM_TIMEOUT_MS=90000

# Voice Interaction Services (Phase 1.6)
VOICE_ENABLED=true
VOICE_SERVICE_URL=http://127.0.0.1:8008
STT_CANDIDATE=faster-whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4
TTS_CANDIDATE=kokoro
TTS_VOICE=hf_alpha
VOICE_TIMEOUT_MS=60000

# Google OAuth 2.0 / Identity Services Configuration
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Security Configuration
SESSION_COOKIE_NAME=ruan_session
SESSION_SECRET=generate_a_random_32_byte_hex_secret_for_production
SESSION_MAX_AGE_MS=604800000

