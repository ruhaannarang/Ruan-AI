# Server Network Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Frontend Client Origin
CLIENT_URL=http://localhost:5173

# AI Runtime Endpoints (Decoupled Services)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gemma-4-e2b-it-qat
STT_CANDIDATE=faster-whisper
TTS_CANDIDATE=piper

# Google OAuth 2.0 / Identity Services Configuration
# Obtain credentials from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session Security Configuration
SESSION_COOKIE_NAME=ruan_session
SESSION_SECRET=generate_a_random_32_byte_hex_secret_for_production
SESSION_MAX_AGE_MS=604800000

